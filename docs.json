{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Clarity Labs Developer Docs",
  "description": "Open-source TypeScript SDKs for regulated AI agents, local-first sync, and durable workflow execution.",
  "theme": "luma",
  "colors": {
    "primary": "#000000",
    "light": "#A0D2FA",
    "dark": "#737373"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://claritylabs.inc"
  },
  "favicon": "/logo/mark.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Clarity Labs",
        "href": "https://claritylabs.inc"
      }
    ],
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/claritylabs-inc"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "CL SDK",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "cl-sdk/index",
              "cl-sdk/quickstart",
              "cl-sdk/architecture",
              "cl-sdk/models"
            ]
          },
          {
            "group": "Extraction",
            "pages": [
              "cl-sdk/extraction/pipeline",
              "cl-sdk/extraction/classification",
              "cl-sdk/extraction/form-inventory",
              "cl-sdk/extraction/applying-results"
            ]
          },
          {
            "group": "Query Agent",
            "pages": ["cl-sdk/query/pipeline", "cl-sdk/query/citations"]
          },
          {
            "group": "Workflows",
            "pages": [
              "cl-sdk/pce/overview",
              "cl-sdk/pce/workflow",
              "cl-sdk/pce/submission-packet",
              "cl-sdk/application/overview",
              "cl-sdk/case/overview"
            ]
          },
          {
            "group": "Foundation",
            "pages": [
              "cl-sdk/source-grounding/overview",
              "cl-sdk/source-grounding/source-spans",
              "cl-sdk/source-grounding/retrieval",
              "cl-sdk/storage/overview",
              "cl-sdk/agent/system-prompt",
              "cl-sdk/agent/tools"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "cl-sdk/reference/api",
              "cl-sdk/reference/types",
              "cl-sdk/reference/policy-taxonomy",
              "cl-sdk/mcp-server"
            ]
          }
        ]
      },
      {
        "tab": "CL Sync",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["cl-sync/index", "cl-sync/quickstart", "cl-sync/concepts"]
          },
          {
            "group": "Core",
            "pages": [
              "cl-sync/store",
              "cl-sync/collections",
              "cl-sync/mutations",
              "cl-sync/migrations"
            ]
          },
          {
            "group": "React",
            "pages": ["cl-sync/react/provider", "cl-sync/react/hooks"]
          },
          {
            "group": "Integrations",
            "pages": ["cl-sync/convex-adapter", "cl-sync/reference"]
          }
        ]
      },
      {
        "tab": "CL Pipelines",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "cl-pipelines/index",
              "cl-pipelines/quickstart",
              "cl-pipelines/concepts"
            ]
          },
          {
            "group": "Phase Runner",
            "pages": [
              "cl-pipelines/phase-runner/overview",
              "cl-pipelines/phase-runner/phases",
              "cl-pipelines/phase-runner/checkpoints",
              "cl-pipelines/phase-runner/retry-modes"
            ]
          },
          {
            "group": "Agent Loop",
            "pages": ["cl-pipelines/agent/overview", "cl-pipelines/agent/tools"]
          },
          {
            "group": "Adapters & UI",
            "pages": [
              "cl-pipelines/adapters/overview",
              "cl-pipelines/adapters/convex",
              "cl-pipelines/ui/overview",
              "cl-pipelines/ui/components"
            ]
          },
          {
            "group": "Reference",
            "pages": ["cl-pipelines/reference"]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/claritylabs-inc"
    }
  }
}
