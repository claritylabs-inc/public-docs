  "keyFeatures": [
    "Provider-agnostic LLM integration via plain callback functions",
    "Source-tree extraction from PDF spans with cited operational facts",
    "Citation-backed query agent with sub-question decomposition",
    "Policy Change Endorsement (PCE) intake and submission packet generation",
    "Insurance application processing with question graphs and auto-fill",
    "Local-first IndexedDB sync with scoped persistence and React hooks",
    "Durable multi-phase pipeline execution with crash-safe checkpoints",
    "LLM agent loop with per-turn checkpointing and tool call support",
    "Convex adapter for both cl-sync and cl-pipelines",
    "Headless React UI components for pipeline status and retry actions",
    "107 canonical ACORD LOB codes with normalization utilities",
    "Composable agent system prompts for email, chat, SMS, Slack, Discord",
    "SQLite reference implementation for DocumentStore, MemoryStore, SourceStore",
    "Apache-2.0 licensed, published to npm, ESM + CJS dual output"
  ],
  "publicApiSurface": [
    "@claritylabs/cl-sdk: createExtractor(config)",
    "@claritylabs/cl-sdk: createQueryAgent(config)",
    "@claritylabs/cl-sdk: createApplicationPipeline(config)",
